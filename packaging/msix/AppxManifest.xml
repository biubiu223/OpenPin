<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for OpenPin. Tokens in $…$ are replaced by build-msix.ps1:
    $IDENTITY_NAME$, $PUBLISHER$, $PUBLISHER_DISPLAY_NAME$, $VERSION$ (a.b.c.0)
  For the Microsoft Store, Identity Name / Publisher / PublisherDisplayName must match the values that
  Partner Center shows for the reserved app name (Product identity page).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="$IDENTITY_NAME$" Publisher="$PUBLISHER$" Version="$VERSION$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>OpenPin</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>开源免费的 Windows 截图软件 · Free and open-source screenshot tool for Windows</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="OpenPin" Executable="OpenPin.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="OpenPin"
        Description="免费开源的截图 / 贴图工具"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows" for the packaged app (HKCU\…\Run is not used when packaged). See Core/AutoStart.cs. -->
        <desktop:Extension Category="windows.startupTask" Executable="OpenPin.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="OpenPinStartup" Enabled="false" DisplayName="OpenPin" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Only used when the user configures a translation service. -->
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <!-- Screen recording: optional microphone / webcam picture-in-picture. -->
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
