<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Recording module strings (keys: Recording.*). Owned by the Recording module. -->

  <!-- control bar -->
  <sys:String x:Key="Recording.Start">开始录制</sys:String>
  <sys:String x:Key="Recording.StartHint">开始录制（{0}）</sys:String>
  <sys:String x:Key="Recording.Stop">停止录制</sys:String>
  <sys:String x:Key="Recording.StopHint">停止录制（{0}）</sys:String>
  <sys:String x:Key="Recording.Pause">暂停</sys:String>
