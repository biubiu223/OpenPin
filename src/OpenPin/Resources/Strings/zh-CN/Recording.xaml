  <sys:String x:Key="Recording.Copy">复制</sys:String>
  <sys:String x:Key="Recording.CloseWindow">关闭</sys:String>
  <sys:String x:Key="Recording.Cancel">取消</sys:String>
  <sys:String x:Key="Recording.OutputInfo">{0} × {1} · {2} fps · {3}</sys:String>
  <sys:String x:Key="Recording.Exporting">正在导出 {0}…</sys:String>
  <sys:String x:Key="Recording.Saved">录屏已保存</sys:String>
  <sys:String x:Key="Recording.Copied">录屏文件已复制，可直接粘贴到聊天窗口或文件夹</sys:String>
  <sys:String x:Key="Recording.ExportFailed">导出失败：{0}</sys:String>
  <sys:String x:Key="Recording.OpenFolder">打开文件夹</sys:String>
  <sys:String x:Key="Recording.SaveDialogTitle">保存录屏</sys:String>
  <sys:String x:Key="Recording.ConfirmCloseUnsaved">录制内容还没有保存，确定关闭吗？</sys:String>
  <sys:String x:Key="Recording.ConfirmRerecord">放弃当前录制内容并重新录制？</sys:String>
</ResourceDictionary>
