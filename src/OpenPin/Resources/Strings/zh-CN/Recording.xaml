  <sys:String x:Key="Recording.PausePlayback">暂停（空格）</sys:String>
  <sys:String x:Key="Recording.TrimHint">拖动时间轴两端的手柄剪掉开头和结尾（[ / ] 设为当前位置）</sys:String>
  <sys:String x:Key="Recording.Format">格式</sys:String>
  <sys:String x:Key="Recording.Quality">质量</sys:String>
  <sys:String x:Key="Recording.QualityLight">轻量</sys:String>
  <sys:String x:Key="Recording.QualityStandard">标准</sys:String>
  <sys:String x:Key="Recording.QualityOriginal">原始</sys:String>
  <sys:String x:Key="Recording.Show">显示</sys:String>
  <sys:String x:Key="Recording.Cursor">光标</sys:String>
  <sys:String x:Key="Recording.Clicks">点击</sys:String>
  <sys:String x:Key="Recording.Wheel">滚轮</sys:String>
  <sys:String x:Key="Recording.KeysShort">按键</sys:String>
