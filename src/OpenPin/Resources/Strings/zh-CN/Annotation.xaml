<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Annotation module strings (keys: Annotation.*). Owned by the Annotation module. -->

  <!-- Tools -->
  <sys:String x:Key="Annotation.Tool.Rectangle">矩形 / 椭圆 (Shift+1，再按切换)</sys:String>
  <sys:String x:Key="Annotation.Tool.Line">直线 / 折线 (Shift+2)&#x0a;拖动画直线，单击逐点画折线，双击或右键结束</sys:String>
  <sys:String x:Key="Annotation.Tool.Arrow">箭头 (Shift+3)&#x0a;双击箭头添加注释文字</sys:String>
  <sys:String x:Key="Annotation.Tool.Serial">序号 (Shift+4)&#x0a;拖动生成指向箭头；选中后 +/- 改编号，A 添加说明</sys:String>
  <sys:String x:Key="Annotation.Tool.Pencil">画笔 (Shift+5)&#x0a;按住 Shift 画直线</sys:String>
  <sys:String x:Key="Annotation.Tool.Highlighter">荧光笔 (Shift+6)</sys:String>
  <sys:String x:Key="Annotation.Tool.Mosaic">马赛克 / 模糊 (Shift+7)</sys:String>
  <sys:String x:Key="Annotation.Tool.Text">文字 (Shift+8)&#x0a;点击已有文字可再次编辑</sys:String>
  <sys:String x:Key="Annotation.Tool.Eraser">橡皮擦 (Shift+9)</sys:String>
  <sys:String x:Key="Annotation.Tool.Spotlight">聚光灯 (Shift+0)</sys:String>
  <sys:String x:Key="Annotation.Tool.Watermark">水印</sys:String>
  <sys:String x:Key="Annotation.Tool.Magnifier">放大镜</sys:String>
  <sys:String x:Key="Annotation.More">更多工具</sys:String>
  <sys:String x:Key="Annotation.Less">收起</sys:String>
  <sys:String x:Key="Annotation.Undo">撤销 (Ctrl+Z)</sys:String>
  <sys:String x:Key="Annotation.Redo">重做 (Ctrl+Y)</sys:String>

  <!-- Common options -->
  <sys:String x:Key="Annotation.Size">大小（滚轮调整）</sys:String>
  <sys:String x:Key="Annotation.Color.Custom">自定义颜色（Ctrl+滚轮调整透明度）</sys:String>
  <sys:String x:Key="Annotation.Color.Hex">颜色值</sys:String>
  <sys:String x:Key="Annotation.Color.Alpha">不透明度</sys:String>
  <sys:String x:Key="Annotation.Color.Hue">色相</sys:String>
  <sys:String x:Key="Annotation.Shape.Rectangle">矩形</sys:String>
  <sys:String x:Key="Annotation.Shape.Ellipse">椭圆</sys:String>
  <sys:String x:Key="Annotation.Shape.Sector">扇形</sys:String>
  <sys:String x:Key="Annotation.Shape.Arc">弧形</sys:String>
  <sys:String x:Key="Annotation.Fill">填充</sys:String>
  <sys:String x:Key="Annotation.Dash.Solid">实线</sys:String>
  <sys:String x:Key="Annotation.Dash.Dash">虚线</sys:String>
  <sys:String x:Key="Annotation.Dash.Dot">点线</sys:String>
  <sys:String x:Key="Annotation.CornerRadius">圆角</sys:String>
  <sys:String x:Key="Annotation.Rotate">拖动旋转（Shift 每次 15°）</sys:String>

  <!-- Line / arrow -->
  <sys:String x:Key="Annotation.Line.Start">起点样式（单击切换）</sys:String>
  <sys:String x:Key="Annotation.Line.End">终点样式（单击切换）</sys:String>
  <sys:String x:Key="Annotation.Line.Style">连接 / 端点样式</sys:String>
  <sys:String x:Key="Annotation.Line.Join">连接</sys:String>
  <sys:String x:Key="Annotation.Line.Cap">端点</sys:String>
  <sys:String x:Key="Annotation.Line.JoinRound">圆角</sys:String>
  <sys:String x:Key="Annotation.Line.JoinMiter">尖角</sys:String>
  <sys:String x:Key="Annotation.Line.JoinBevel">斜角</sys:String>
  <sys:String x:Key="Annotation.Line.CapRound">圆头</sys:String>
  <sys:String x:Key="Annotation.Line.CapFlat">平头</sys:String>
  <sys:String x:Key="Annotation.Line.CapSquare">方头</sys:String>
  <sys:String x:Key="Annotation.Arrow.Tapered">实心渐细</sys:String>
  <sys:String x:Key="Annotation.Arrow.Solid">实心箭头</sys:String>
  <sys:String x:Key="Annotation.Arrow.Line">线条箭头</sys:String>
  <sys:String x:Key="Annotation.Arrow.Double">双向箭头</sys:String>

  <!-- Serial -->
  <sys:String x:Key="Annotation.Serial.Number">数字 1, 2, 3</sys:String>
  <sys:String x:Key="Annotation.Serial.Letter">字母 A, B, C</sys:String>
  <sys:String x:Key="Annotation.Serial.Roman">罗马数字 I, II, III</sys:String>
  <sys:String x:Key="Annotation.Serial.Next">下一个序号</sys:String>
  <sys:String x:Key="Annotation.Serial.Renumber">删除后自动重新编号</sys:String>

