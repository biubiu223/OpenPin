  <sys:String x:Key="Annotation.Mode.Brush">画笔</sys:String>
  <sys:String x:Key="Annotation.Mode.Rect">矩形</sys:String>
  <sys:String x:Key="Annotation.Mode.Partial">局部擦除（擦掉标注的一部分）</sys:String>
  <sys:String x:Key="Annotation.Blend.Multiply">正片叠底</sys:String>
  <sys:String x:Key="Annotation.Blend.Translucent">半透明</sys:String>
  <sys:String x:Key="Annotation.Mosaic.Mosaic">马赛克</sys:String>
  <sys:String x:Key="Annotation.Mosaic.Blur">模糊</sys:String>
  <sys:String x:Key="Annotation.Mosaic.Strength">强度</sys:String>
  <sys:String x:Key="Annotation.Eraser.ClearAll">清空全部标注</sys:String>
  <sys:String x:Key="Annotation.Eraser.Clear">清空</sys:String>

  <!-- Text -->
  <sys:String x:Key="Annotation.Text.Font">字体</sys:String>
  <sys:String x:Key="Annotation.Text.Bold">粗体</sys:String>
  <sys:String x:Key="Annotation.Text.Italic">斜体</sys:String>
  <sys:String x:Key="Annotation.Text.Outline">描边</sys:String>
  <sys:String x:Key="Annotation.Text.OutlineColor">描边颜色</sys:String>
  <sys:String x:Key="Annotation.Text.Background">背景</sys:String>
  <sys:String x:Key="Annotation.Text.BackgroundColor">背景颜色</sys:String>
  <sys:String x:Key="Annotation.Text.BackgroundSettings">背景设置</sys:String>
  <sys:String x:Key="Annotation.Text.BackgroundOpacity">不透明度</sys:String>
  <sys:String x:Key="Annotation.Text.BackgroundRadius">圆角</sys:String>
  <sys:String x:Key="Annotation.Text.BackgroundPadding">内边距</sys:String>

  <!-- Spotlight / watermark / magnifier -->
  <sys:String x:Key="Annotation.Spotlight.Opacity">遮罩不透明度（滚轮调整）</sys:String>
  <sys:String x:Key="Annotation.Watermark.Text">水印文字，可用 $yyyy-MM-dd HH:mm:ss$ 插入时间</sys:String>
  <sys:String x:Key="Annotation.Watermark.Layout">位置</sys:String>
  <sys:String x:Key="Annotation.Watermark.Tile">平铺</sys:String>
  <sys:String x:Key="Annotation.Watermark.TopLeft">左上</sys:String>
  <sys:String x:Key="Annotation.Watermark.TopRight">右上</sys:String>
  <sys:String x:Key="Annotation.Watermark.BottomLeft">左下</sys:String>
  <sys:String x:Key="Annotation.Watermark.BottomRight">右下</sys:String>
  <sys:String x:Key="Annotation.Watermark.TopCenter">上中</sys:String>
  <sys:String x:Key="Annotation.Watermark.BottomCenter">下中</sys:String>
  <sys:String x:Key="Annotation.Watermark.Center">居中</sys:String>
  <sys:String x:Key="Annotation.Watermark.Opacity">不透明度</sys:String>
