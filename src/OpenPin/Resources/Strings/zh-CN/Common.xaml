  <sys:String x:Key="Action.CapturePin">截图并贴图</sys:String>
  <sys:String x:Key="Action.CaptureOcr">截图并识别文字</sys:String>
  <sys:String x:Key="Action.CaptureSave">截图并保存</sys:String>
  <sys:String x:Key="Action.CaptureQuickSave">截图并快速保存</sys:String>
  <sys:String x:Key="Action.CaptureFullScreenCopy">截取屏幕并复制</sys:String>
  <sys:String x:Key="Action.CaptureLastRegionCopy">截取上次区域并复制</sys:String>
  <sys:String x:Key="Action.CaptureLong">长截图</sys:String>
  <sys:String x:Key="Action.CaptureRecord">屏幕录制</sys:String>
