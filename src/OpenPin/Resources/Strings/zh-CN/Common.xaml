<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Core / shared strings. Owned by the core (project lead). -->
  <sys:String x:Key="Common.OK">确定</sys:String>
  <sys:String x:Key="Common.Cancel">取消</sys:String>
  <sys:String x:Key="Common.Apply">应用</sys:String>
  <sys:String x:Key="Common.Close">关闭</sys:String>
  <sys:String x:Key="Common.Delete">删除</sys:String>
  <sys:String x:Key="Common.Yes">是</sys:String>
  <sys:String x:Key="Common.No">否</sys:String>
  <sys:String x:Key="Common.NotImplemented">该功能正在开发中</sys:String>
  <sys:String x:Key="Common.ActionFailed">操作失败：{0}</sys:String>
  <sys:String x:Key="Common.HotkeyConflict">以下快捷键被其他程序占用，请在设置中修改：{0}</sys:String>
