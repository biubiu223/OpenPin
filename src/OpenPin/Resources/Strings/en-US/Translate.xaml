<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Translate module strings (keys: Translate.*). Owned by the Translate module. -->
  <sys:String x:Key="Translate.Title">Translate</sys:String>
  <sys:String x:Key="Translate.NotConfigured">Translation service is not configured. OpenPin runs offline by default. Please choose a provider and enter your API Key in Settings.</sys:String>
  <sys:String x:Key="Translate.OpenSettings">Go to Settings</sys:String>
  <sys:String x:Key="Translate.OcrUnavailable">Translation requires OCR: Please install the OCR language pack in Windows Settings</sys:String>
  <sys:String x:Key="Translate.NoText">No translatable text recognized</sys:String>
  <sys:String x:Key="Translate.Working">Translating…</sys:String>
  <sys:String x:Key="Translate.Failed">Translation failed: {0}</sys:String>

  <!-- Languages -->
  <sys:String x:Key="Translate.Lang.FollowApp">Follow App Language</sys:String>
  <sys:String x:Key="Translate.Lang.zh-Hans">Simplified Chinese</sys:String>
  <sys:String x:Key="Translate.Lang.zh-Hant">Traditional Chinese</sys:String>
  <sys:String x:Key="Translate.Lang.en">English</sys:String>
  <sys:String x:Key="Translate.Lang.ja">Japanese</sys:String>
  <sys:String x:Key="Translate.Lang.ko">Korean</sys:String>
  <sys:String x:Key="Translate.Lang.fr">French</sys:String>
  <sys:String x:Key="Translate.Lang.de">German</sys:String>
  <sys:String x:Key="Translate.Lang.es">Spanish</sys:String>
  <sys:String x:Key="Translate.Lang.pt">Portuguese</sys:String>
  <sys:String x:Key="Translate.Lang.id">Indonesian</sys:String>
  <sys:String x:Key="Translate.Lang.ms">Malay</sys:String>
  <sys:String x:Key="Translate.Lang.it">Italian</sys:String>
  <sys:String x:Key="Translate.Lang.ru">Russian</sys:String>
  <sys:String x:Key="Translate.Lang.th">Thai</sys:String>
  <sys:String x:Key="Translate.Lang.vi">Vietnamese</sys:String>
  <sys:String x:Key="Translate.Lang.ar">Arabic</sys:String>
  <sys:String x:Key="Translate.Lang.tr">Turkish</sys:String>

  <!-- Providers -->
  <sys:String x:Key="Translate.Provider.none">Not configured (offline)</sys:String>
  <sys:String x:Key="Translate.Provider.openai">OpenAI Compatible API</sys:String>
  <sys:String x:Key="Translate.Provider.baidu">Baidu Translate</sys:String>
  <sys:String x:Key="Translate.Provider.youdao">Youdao AI</sys:String>
  <sys:String x:Key="Translate.Provider.deepl">DeepL</sys:String>

  <!-- Errors -->
  <sys:String x:Key="Translate.Error.Count">Translation count mismatch ({0} source segments, {1} translated segments)</sys:String>
  <sys:String x:Key="Translate.Error.ProxyAddress">Invalid proxy address. Please enter host:port, e.g. 127.0.0.1:7890</sys:String>
  <sys:String x:Key="Translate.Error.Http">{0} returned error {1}: {2}</sys:String>
  <sys:String x:Key="Translate.Error.Timeout">{0} request timed out, please check your network or proxy settings</sys:String>
  <sys:String x:Key="Translate.Error.Network">Cannot connect to {0}: {1}</sys:String>
  <sys:String x:Key="Translate.Error.NoModel">Please enter model name</sys:String>
  <sys:String x:Key="Translate.Error.NoBaseUrl">Please enter a valid API URL (http:// or https://)</sys:String>
  <sys:String x:Key="Translate.Error.BadResponse">{0} returned unrecognized content: {1}</sys:String>
  <sys:String x:Key="Translate.Error.NoKey">Please enter API key for {0} in Settings</sys:String>
  <sys:String x:Key="Translate.Error.Provider">{0}: {1}</sys:String>
  <sys:String x:Key="Translate.Error.BadCredentials">Invalid ID or secret key</sys:String>
  <sys:String x:Key="Translate.Error.RateLimited">Request rate limit exceeded, please try again later</sys:String>
  <sys:String x:Key="Translate.Error.NoBalance">Insufficient account balance or quota</sys:String>
  <sys:String x:Key="Translate.Error.LanguageUnsupported">Language not supported</sys:String>
  <sys:String x:Key="Translate.Error.TargetUnsupported">{0} does not support translation to {1}. Please select another target language or service.</sys:String>

  <!-- Result window -->
  <sys:String x:Key="Translate.Window.Title">Translation</sys:String>
  <sys:String x:Key="Translate.Window.Retranslate">Translate</sys:String>
  <sys:String x:Key="Translate.Window.Provider">Provider: {0}</sys:String>
  <sys:String x:Key="Translate.Window.TargetLabel">Translate to</sys:String>
  <sys:String x:Key="Translate.Window.Source">Source</sys:String>
  <sys:String x:Key="Translate.Window.Translation">Translation</sys:String>
  <sys:String x:Key="Translate.Window.Copy">Copy</sys:String>
  <sys:String x:Key="Translate.Window.Copied">Copied</sys:String>
  <sys:String x:Key="Translate.Window.Working">Translating…</sys:String>
  <sys:String x:Key="Translate.Window.WorkingElapsed">Translating… ({0:0.0}s)</sys:String>
  <sys:String x:Key="Translate.Window.Detected">(Detected as {0})</sys:String>
  <sys:String x:Key="Translate.Window.Done">Translated {0} segments · {1:0.0}s · Press Ctrl+Enter to retranslate after editing source</sys:String>

  <!-- Settings view -->
  <sys:String x:Key="Translate.Settings.SectionService">Translation Service</sys:String>
  <sys:String x:Key="Translate.Settings.Provider">Provider</sys:String>
  <sys:String x:Key="Translate.Settings.ProviderHint">OpenPin makes no network requests when unconfigured. API Keys are encrypted with Windows DPAPI and accessible only to current user.</sys:String>
  <sys:String x:Key="Translate.Settings.ProviderLong.openai">OpenAI compatible API (DeepSeek, Qwen, Kimi, GLM, Ollama…)</sys:String>
  <sys:String x:Key="Translate.Settings.ProviderLong.baidu">Baidu Translate</sys:String>
  <sys:String x:Key="Translate.Settings.ProviderLong.youdao">Youdao AI</sys:String>
  <sys:String x:Key="Translate.Settings.ProviderLong.deepl">DeepL</sys:String>
  <sys:String x:Key="Translate.Settings.Preset">Preset</sys:String>
  <sys:String x:Key="Translate.Settings.PresetCustom">Custom</sys:String>
  <sys:String x:Key="Translate.Settings.BaseUrl">API Base URL</sys:String>
  <sys:String x:Key="Translate.Settings.Model">Model</sys:String>
  <sys:String x:Key="Translate.Settings.ApiKey">API Key</sys:String>
  <sys:String x:Key="Translate.Settings.OpenAiHint">Base URL only needs up to /v1 (/chat/completions is appended automatically). Local Ollama / LM Studio does not require a Key.</sys:String>
  <sys:String x:Key="Translate.Settings.BaiduAppId">APP ID</sys:String>
  <sys:String x:Key="Translate.Settings.BaiduSecret">Secret Key</sys:String>
  <sys:String x:Key="Translate.Settings.BaiduHint">Obtain from Baidu Translation Open Platform (fanyi-api.baidu.com) under General Text Translation.</sys:String>
  <sys:String x:Key="Translate.Settings.YoudaoAppKey">App ID</sys:String>
  <sys:String x:Key="Translate.Settings.YoudaoSecret">App Secret</sys:String>
  <sys:String x:Key="Translate.Settings.YoudaoHint">Obtain from Youdao AI Cloud (ai.youdao.com) after creating a Text Translation application.</sys:String>
  <sys:String x:Key="Translate.Settings.DeepLKey">API Key</sys:String>
  <sys:String x:Key="Translate.Settings.DeepLHint">Keys ending with :fx are Free tier and will automatically use api-free.deepl.com.</sys:String>
  <sys:String x:Key="Translate.Settings.ShowKey">Show / Hide</sys:String>
  <sys:String x:Key="Translate.Settings.SectionLanguage">Languages</sys:String>
  <sys:String x:Key="Translate.Settings.Target">Target Language</sys:String>
  <sys:String x:Key="Translate.Settings.Fallback">Fallback Language</sys:String>
  <sys:String x:Key="Translate.Settings.FallbackHint">When the source is already the target language, translates to the fallback language instead.</sys:String>
  <sys:String x:Key="Translate.Settings.SectionImage">Image Translation</sys:String>
  <sys:String x:Key="Translate.Settings.Mode">Output Mode</sys:String>
  <sys:String x:Key="Translate.Settings.ModeText">Image → Text (side-by-side source and translation window)</sys:String>
  <sys:String x:Key="Translate.Settings.ModeImage">Image → Image (overlay translation on image, new pin)</sys:String>
  <sys:String x:Key="Translate.Settings.SectionNetwork">Network</sys:String>
  <sys:String x:Key="Translate.Settings.Proxy">Proxy</sys:String>
  <sys:String x:Key="Translate.Settings.Proxy.None">No Proxy</sys:String>
  <sys:String x:Key="Translate.Settings.Proxy.System">System Proxy</sys:String>
  <sys:String x:Key="Translate.Settings.Proxy.Http">HTTP Proxy</sys:String>
  <sys:String x:Key="Translate.Settings.Proxy.Socks5">SOCKS5 Proxy</sys:String>
  <sys:String x:Key="Translate.Settings.ProxyAddressTip">host:port, e.g. 127.0.0.1:7890</sys:String>
  <sys:String x:Key="Translate.Settings.Timeout">Timeout (seconds)</sys:String>
  <sys:String x:Key="Translate.Settings.Test">Test Connection</sys:String>
  <sys:String x:Key="Translate.Settings.Testing">Testing…</sys:String>
  <sys:String x:Key="Translate.Settings.TestChooseProvider">Please select a translation service first</sys:String>
  <sys:String x:Key="Translate.Settings.TestOk">Connection successful: {0} → {1} ({2:0.0}s)</sys:String>
  <sys:String x:Key="Translate.Settings.TestFailed">Connection failed: {0}</sys:String>
  <sys:String x:Key="Translate.Settings.FetchModels">Fetch Models</sys:String>
  <sys:String x:Key="Translate.Settings.FetchingModels">Fetching model list…</sys:String>
  <sys:String x:Key="Translate.Settings.ModelsFetched">Found {0} models, selectable from dropdown</sys:String>
  <sys:String x:Key="Translate.Settings.ModelsEmpty">Service returned no models, please enter model name manually</sys:String>
  <sys:String x:Key="Translate.Settings.ModelsFailed">Failed to fetch models: {0}</sys:String>
  <sys:String x:Key="Translate.Settings.ModelsTimeout">Fetching models timed out, please check network or proxy settings</sys:String>
  <sys:String x:Key="Translate.Settings.ModelsHttpError">Service returned {0}: {1}</sys:String>
  <sys:String x:Key="Translate.Settings.ModelTip">You can enter a model name directly or click "Fetch Models" to retrieve available models from the service</sys:String>
  <sys:String x:Key="Translate.Settings.ReasoningModelHint">💡 Tip: This model uses deep reasoning/thinking (R1/Reasoner) which adds latency. We recommend fast chat models (like deepseek-chat or DeepSeek-V3) for sub-second translations.</sys:String>
</ResourceDictionary>
