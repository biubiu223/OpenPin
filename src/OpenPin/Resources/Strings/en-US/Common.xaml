<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Core / shared strings. Owned by the core (project lead). -->
  <sys:String x:Key="Common.OK">OK</sys:String>
  <sys:String x:Key="Common.Cancel">Cancel</sys:String>
  <sys:String x:Key="Common.Apply">Apply</sys:String>
  <sys:String x:Key="Common.Close">Close</sys:String>
  <sys:String x:Key="Common.Delete">Delete</sys:String>
  <sys:String x:Key="Common.Yes">Yes</sys:String>
  <sys:String x:Key="Common.No">No</sys:String>
  <sys:String x:Key="Common.NotImplemented">This feature is under development</sys:String>
  <sys:String x:Key="Common.ActionFailed">Operation failed: {0}</sys:String>
  <sys:String x:Key="Common.HotkeyConflict">The following hotkeys are in use by other applications, please reassign them in Settings: {0}</sys:String>
  <sys:String x:Key="Common.StartedHint">OpenPin is running in the background. Capture {0}, Pin {1}</sys:String>
  <sys:String x:Key="Common.AlreadyRunning">OpenPin is already running</sys:String>

  <!-- Global actions (tray menu, hotkey settings) -->
  <sys:String x:Key="Action.Capture">Capture</sys:String>
  <sys:String x:Key="Action.CaptureCustom">Custom / Delayed Capture</sys:String>
  <sys:String x:Key="Action.CaptureCopy">Capture and Copy</sys:String>
  <sys:String x:Key="Action.CapturePin">Capture and Pin</sys:String>
  <sys:String x:Key="Action.CaptureOcr">Capture and OCR</sys:String>
  <sys:String x:Key="Action.CaptureSave">Capture and Save</sys:String>
  <sys:String x:Key="Action.CaptureQuickSave">Capture and Quick Save</sys:String>
  <sys:String x:Key="Action.CaptureFullScreenCopy">Capture Full Screen to Clipboard</sys:String>
  <sys:String x:Key="Action.CaptureLastRegionCopy">Capture Last Region to Clipboard</sys:String>
  <sys:String x:Key="Action.CaptureLong">Scrolling Screenshot</sys:String>
  <sys:String x:Key="Action.CaptureRecord">Screen Recording</sys:String>
  <sys:String x:Key="Action.TranslateMirror">DeskMirror Translation</sys:String>
  <sys:String x:Key="Action.PinClipboard">Pin from Clipboard</sys:String>
  <sys:String x:Key="Action.PinFromFile">Pin from File</sys:String>
  <sys:String x:Key="Action.PinRestore">Restore Last Closed Pin</sys:String>
  <sys:String x:Key="Action.PinCloseAll">Close All Pins</sys:String>
  <sys:String x:Key="Action.PinDestroyAll">Destroy All Pins</sys:String>
  <sys:String x:Key="Action.PinToggleHideAll">Toggle Hide All Pins</sys:String>
  <sys:String x:Key="Action.PinToggleClickThrough">Toggle Mouse Click-Through</sys:String>
  <sys:String x:Key="Action.PinNextGroup">Switch Pin Group</sys:String>
  <sys:String x:Key="Action.ToggleHotkeys">Disable Hotkeys</sys:String>
  <sys:String x:Key="Action.OpenSettings">Settings</sys:String>
  <sys:String x:Key="Action.Exit">Exit</sys:String>

  <!-- Tray -->
  <sys:String x:Key="Tray.OpenDataFolder">Open Data Folder</sys:String>
</ResourceDictionary>
