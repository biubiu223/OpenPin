<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Capture module strings (keys: Capture.*). Owned by the Capture module. -->

  <!-- Toolbar host actions -->
  <sys:String x:Key="Capture.Action.Style">Style (Corner / Shadow / Border / Ratio)</sys:String>
  <sys:String x:Key="Capture.Action.LongCapture">Scrolling Screenshot</sys:String>
  <sys:String x:Key="Capture.Action.Record">Screen Recording</sys:String>
  <sys:String x:Key="Capture.Action.Mirror">DeskMirror (Shift+M)</sys:String>
  <sys:String x:Key="Capture.Action.Ocr">OCR (Shift+C)</sys:String>
  <sys:String x:Key="Capture.Action.Recognize">Recognize: Text / Translate / Table / QR &amp; Barcode</sys:String>
  <sys:String x:Key="Capture.Action.Translate">Translate (Ctrl+Q)</sys:String>
  <sys:String x:Key="Capture.Action.Pin">Pin (Ctrl+T)</sys:String>
  <sys:String x:Key="Capture.Action.Save">Save (Ctrl+S)</sys:String>
  <sys:String x:Key="Capture.Action.Copy">Copy (Enter / Ctrl+C)</sys:String>
  <sys:String x:Key="Capture.Action.Close">Close (Esc)</sys:String>

  <!-- Magnifier -->
  <sys:String x:Key="Capture.Magnifier.Position">Position {0}, {1}</sys:String>
  <sys:String x:Key="Capture.Magnifier.Size">Region {0} × {1}</sys:String>
  <sys:String x:Key="Capture.Magnifier.Hint">C Copy Color · Shift Switch Format</sys:String>
  <sys:String x:Key="Capture.ColorCopied">Copied color {0}</sys:String>

  <!-- Size label / exact size input (CAP-07) -->
  <sys:String x:Key="Capture.Size.EditTip">Click to enter exact width and height</sys:String>
  <sys:String x:Key="Capture.Size.Width">Width</sys:String>
  <sys:String x:Key="Capture.Size.Height">Height</sys:String>

  <!-- Shortcut hints (CAP-16) -->
  <sys:String x:Key="Capture.Hints.Title">Shortcuts</sys:String>
  <sys:String x:Key="Capture.Hints.Select">Drag to select region · Click to select window · Double-click to copy</sys:String>
  <sys:String x:Key="Capture.Hints.Wheel">Mouse wheel: switch parent / child element</sys:String>
  <sys:String x:Key="Capture.Hints.Copy">Enter / Ctrl+C Copy · Ctrl+T Pin</sys:String>
  <sys:String x:Key="Capture.Hints.Save">Ctrl+S Save · Ctrl+Shift+S Quick Save</sys:String>
  <sys:String x:Key="Capture.Hints.Arrows">Arrow keys move 1px · Shift/Ctrl+Arrow shrink/expand</sys:String>
  <sys:String x:Key="Capture.Hints.Misc">Shift+C OCR · Ctrl+A Full Screen · ` Toggle Cursor</sys:String>
  <sys:String x:Key="Capture.Hints.Recognize">Ctrl+Q Translate · Shift+Q Table · Q QR / Barcode</sys:String>
  <sys:String x:Key="Capture.Hints.History">R / Shift+R Region history · &lt; / &gt; Screenshot history</sys:String>
  <sys:String x:Key="Capture.Hints.Exit">Alt Guide lines · Right-click / Esc Cancel or Exit</sys:String>

  <!-- Results / notifications -->
  <sys:String x:Key="Capture.Copied">Screenshot copied to clipboard</sys:String>
  <sys:String x:Key="Capture.FullScreenCopied">Full screen screenshot copied</sys:String>
  <sys:String x:Key="Capture.LastRegionCopied">Last region screenshot copied</sys:String>
  <sys:String x:Key="Capture.NoLastRegion">No previous region recorded</sys:String>
  <sys:String x:Key="Capture.OcrCopied">Recognized text copied ({0} characters)</sys:String>
  <sys:String x:Key="Capture.OcrShow">View / Edit</sys:String>
  <sys:String x:Key="Capture.OcrNoText">No text detected</sys:String>
  <sys:String x:Key="Capture.OcrUnavailable">OCR unavailable: Please install the OCR language pack in Windows Settings</sys:String>
  <sys:String x:Key="Capture.Failed">Screenshot failed: {0}</sys:String>
  <sys:String x:Key="Capture.ConfirmExit">Are you sure you want to exit capture?</sys:String>
  <sys:String x:Key="Capture.HistoryEmpty">History is empty</sys:String>
  <sys:String x:Key="Capture.HistoryImage">History screenshot {0}/{1} · {2:yyyy-MM-dd HH:mm:ss}</sys:String>
  <sys:String x:Key="Capture.HistoryRegion">History region {0}/{1}</sys:String>
  <sys:String x:Key="Capture.CursorShown">Cursor shown</sys:String>
  <sys:String x:Key="Capture.CursorHidden">Cursor hidden</sys:String>

  <!-- QR (CAP-12) -->
  <sys:String x:Key="Capture.Qr.Found">Found {0} QR / barcode(s), press Q to view</sys:String>
  <sys:String x:Key="Capture.Qr.None">No QR code or barcode detected</sys:String>
  <sys:String x:Key="Capture.Qr.Disabled">QR / barcode recognition is disabled in Settings</sys:String>
  <sys:String x:Key="Capture.Qr.Detecting">Scanning for QR / barcode…</sys:String>
  <sys:String x:Key="Capture.Qr.Copy">Copy</sys:String>
  <sys:String x:Key="Capture.Qr.Open">Open Link</sys:String>
  <sys:String x:Key="Capture.Qr.Copied">QR / barcode content copied</sys:String>

  <!-- "识别" flyout (PRO-01 / PRO-02 / PRO-05 / PRO-09 / PRO-10) -->
  <sys:String x:Key="Capture.Recognize.Ocr">OCR Text</sys:String>
  <sys:String x:Key="Capture.Recognize.Latex">Formula (LaTeX)</sys:String>
  <sys:String x:Key="Capture.Recognize.Translate">Translate</sys:String>
  <sys:String x:Key="Capture.Recognize.Mirror">DeskMirror</sys:String>
  <sys:String x:Key="Capture.Recognize.Table">Table Recognition</sys:String>
  <sys:String x:Key="Capture.Recognize.Qr">QR / Barcode</sys:String>
  <sys:String x:Key="Capture.Recognize.OcrLanguage">OCR Language</sys:String>

  <!-- Output style flyout (CAP-11) -->
  <sys:String x:Key="Capture.Style.Corner">Rounded Corners</sys:String>
  <sys:String x:Key="Capture.Style.Shadow">Shadow</sys:String>
  <sys:String x:Key="Capture.Style.Border">Border</sys:String>
  <sys:String x:Key="Capture.Style.Ratio">Aspect Ratio</sys:String>
  <sys:String x:Key="Capture.Style.Free">Free</sys:String>
  <sys:String x:Key="Capture.Style.Note">Corners / borders apply to copy, save, and pin; shadows do not apply to pin</sys:String>

  <!-- Custom / delayed capture dialog (CAP-14) -->
  <sys:String x:Key="Capture.Custom.Title">Custom / Delayed Capture</sys:String>
  <sys:String x:Key="Capture.Custom.Region">Region (Physical Pixels)</sys:String>
  <sys:String x:Key="Capture.Custom.Delay">Delay (Seconds)</sys:String>
  <sys:String x:Key="Capture.Custom.Preset">Preset</sys:String>
  <sys:String x:Key="Capture.Custom.SavePreset">Save as Preset</sys:String>
  <sys:String x:Key="Capture.Custom.DeletePreset">Delete Preset</sys:String>
  <sys:String x:Key="Capture.Custom.PresetName">Preset {0}</sys:String>
  <sys:String x:Key="Capture.Custom.UseLast">Last Region</sys:String>
  <sys:String x:Key="Capture.Custom.UseScreen">Current Screen</sys:String>
  <sys:String x:Key="Capture.Custom.DirectCopy">Direct Copy (do not open capture UI)</sys:String>
  <sys:String x:Key="Capture.Custom.Start">Start Capture</sys:String>
  <sys:String x:Key="Capture.Custom.Invalid">Invalid region: Width and height must be greater than 0 and overlap the screen</sys:String>
  <sys:String x:Key="Capture.Custom.Countdown">Capturing in {0}s</sys:String>
</ResourceDictionary>
