<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    LIGHT theme tokens (UI-03). Theme.Dark.xaml MUST define exactly the same keys (a unit test checks it).
    Core/Theme/ThemeManager swaps this dictionary at runtime and overrides the accent-derived tokens
    (Color.Accent, Brush.Accent, Brush.OnAccent, Color.PinActive, Brush.*.Selection …) with the configured accent.
    Modules reference these keys with DynamicResource / SetResourceReference only (StaticResource would not update).
    Theme-independent styles, fonts and metrics live in Theme.xaml.
  -->

  <!-- ===================================================================== base colors -->
  <Color x:Key="Color.Accent">#FF1677FF</Color>
  <Color x:Key="Color.Surface">#FFFFFFFF</Color>
  <Color x:Key="Color.SurfaceAlt">#FFF5F6F8</Color>
  <Color x:Key="Color.Border">#FFE3E5E8</Color>
  <Color x:Key="Color.Text">#FF1F1F1F</Color>
  <Color x:Key="Color.TextSecondary">#FF6B6F76</Color>
  <Color x:Key="Color.Hover">#14000000</Color>
  <Color x:Key="Color.Pressed">#26000000</Color>
  <Color x:Key="Color.Danger">#FFE5484D</Color>
  <Color x:Key="Color.Warning">#FFFA8C16</Color>
  <Color x:Key="Color.Success">#FF52C41A</Color>
  <Color x:Key="Color.Shadow">#40000000</Color>

  <!-- Pin window shadow states (see docs/SPEC.md §3) -->
  <Color x:Key="Color.PinActive">#FF1677FF</Color>
  <Color x:Key="Color.PinInactive">#FF8C8C8C</Color>
  <Color x:Key="Color.PinLocked">#FFFA8C16</Color>
  <Color x:Key="Color.PinClickThrough">#FF52C41A</Color>

  <!-- ===================================================================== base brushes -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#FF1677FF" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FFF5F6F8" />
  <SolidColorBrush x:Key="Brush.Border" Color="#FFE3E5E8" />
  <SolidColorBrush x:Key="Brush.Text" Color="#FF1F1F1F" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF6B6F76" />
  <SolidColorBrush x:Key="Brush.Hover" Color="#14000000" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="#26000000" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#FFE5484D" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#FFFA8C16" />
  <SolidColorBrush x:Key="Brush.Success" Color="#FF52C41A" />
  <!-- Text/icons drawn on top of Brush.Accent (primary buttons, badges); recomputed from the accent luminance -->
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
  <!-- Thin scroll bars (implicit ScrollBar style in Theme.xaml) -->
  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#59000000" />
  <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#8C000000" />
  <!-- Tooltips -->
  <SolidColorBrush x:Key="Brush.ToolTip" Color="#FFF9F9F9" />

  <DropShadowEffect x:Key="Effect.Shadow" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.25" Color="Black" />

  <!-- ===================================================================== module tokens that depend on the theme / accent -->
  <!-- Pin: zoom / title badges, OCR text selection -->
  <SolidColorBrush x:Key="Brush.Pin.Badge" Color="#FF1F1F1F" Opacity="0.78" />
  <SolidColorBrush x:Key="Brush.Pin.BadgeText" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Pin.Selection" Color="#FF1677FF" Opacity="0.32" />

  <!-- Recording: region frame (blue = ready, red = recording, orange = paused), countdown, trim timeline -->
  <SolidColorBrush x:Key="Brush.Recording.Ready" Color="#FF1677FF" />
  <SolidColorBrush x:Key="Brush.Recording.Active" Color="#FFE5484D" />
  <SolidColorBrush x:Key="Brush.Recording.Paused" Color="#FFFA8C16" />
  <SolidColorBrush x:Key="Brush.Recording.Countdown" Color="#FF1F1F1F" Opacity="0.72" />
  <SolidColorBrush x:Key="Brush.Recording.PreviewBackground" Color="#FF1F1F1F" Opacity="0.06" />
  <SolidColorBrush x:Key="Brush.Recording.TrimShade" Color="#FF1F1F1F" Opacity="0.18" />
  <SolidColorBrush x:Key="Brush.Recording.TrimRange" Color="#FF1677FF" Opacity="0.22" />

  <!-- LongCapture: preview viewport marker -->
  <SolidColorBrush x:Key="Brush.LongCapture.ViewportFill" Color="#261677FF" />

  <!-- Capture: magnifier cross-hair -->
  <SolidColorBrush x:Key="Brush.Capture.MagnifierCross" Color="#5C1677FF" />

  <!-- Services: transparency checkerboard behind the save preview -->
  <DrawingBrush x:Key="Brush.Services.PreviewBackdrop" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFF5F6F8" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Brush="#FFE3E5E8" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
